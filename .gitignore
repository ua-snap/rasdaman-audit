# Python bytecode cache (created just by importing/running the scripts)
__pycache__/
*.pyc

# macOS Finder metadata
.DS_Store

# One-off scratch output from the manual duplicate-index check (README step 5)
tiles.json

# Default local destination for a fresh rasdaman_tiling_audit.py run
# (README points --outdir outside the repo, e.g. ~/tiling_audit -- this is
# just a guard in case it's ever pointed here instead)
/tiling_audit/

# Session scratch notes, not for the team
/PLAN.md

# Raw boundary-polygon snapshot (100+ MB) -- regenerate with
# utilities/fetch_boundaries.py rather than committing it; only the small
# derived polygon_area_buckets.json is checked in
/utilities/data/boundaries.geojson
/utilities/data/boundaries.geojson.gz

# Generated test fixtures -- regenerate with tests/make_test_netcdf.py and
# tests/make_gipl_shape_netcdf.py respectively
/utilities/tests/synthetic_gipl_like.nc
/utilities/tests/gipl_shape.nc
